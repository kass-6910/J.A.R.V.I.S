# .env de production de Jarvis sur le VPS (à copier en /opt/jarvis/.env, droits 600).
# Les valeurs vides sont des secrets : à remplir sur le serveur, jamais dans une conversation ni dans Git.
# PORT, HOST, DATABASE_URL et DATA_DIR sont fixés par docker-compose.prod.yml.

# --- Indispensable ---
JARVIS_TOKEN=
JARVIS_DB_PASSWORD=
ANTHROPIC_API_KEY=
PUBLIC_URL=https://jarvis.manageo.site
TIMEZONE=Europe/Paris

# --- Notifications (app ntfy) ---
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# --- Google : Agenda, Gmail, trajets ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_IDS=primary
GMAIL_ENABLED=false
GOOGLE_MAPS_API_KEY=
HOME_ADDRESS=
TRAVEL_MODE=TRANSIT

# --- Outlook de l'école ---
MS_CLIENT_ID=
MS_TENANT=organizations
MS_REFRESH_TOKEN=

# --- Manageo : même VPS, mais Jarvis passe par l'API publique (jamais par la base) ---
MANAGEO_URL=https://manageo.site
MANAGEO_API_KEY=

# --- Préférences ---
BRIEFING_TIME=07:00
EVENING_TIME=21:30
PRAYER_METHOD=12
SPORT_SESSIONS_PER_WEEK=3
MEAL_KCAL_TARGET=3000
BUDGET_MONTHLY_EUR=0
