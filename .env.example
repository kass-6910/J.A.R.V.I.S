# --- Serveur ---
PORT=3000
HOST=0.0.0.0
TIMEZONE=Europe/Paris
# Jeton secret des Raccourcis et de la web app (générer avec : openssl rand -hex 32)
JARVIS_TOKEN=
DATABASE_URL=postgres://jarvis:jarvis@localhost:5432/jarvis

# --- IA (console Anthropic) ---
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-sonnet-5-5
JARVIS_EFFORT=medium

# --- Planning ---
PLANNING_DAY_START=08:00
PLANNING_DAY_END=22:00

# --- Google Agenda (lecture seule). Laisser vide pour démarrer sans agenda. ---
# Obtenir le refresh token : npm run google:auth -w server
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_IDS=primary

# --- Notifications (ntfy) ---
# Installer l'app ntfy sur l'iPhone et s'abonner au sujet ci-dessous.
# Choisir un sujet long et imprévisible (openssl rand -hex 16) : sur ntfy.sh, qui connaît le sujet peut lire les messages.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Jeton d'accès, si le serveur ntfy est protégé (serveur ntfy auto-hébergé ou compte ntfy.sh).
NTFY_TOKEN=
# Adresse de la web app, ouverte quand on touche une notification.
PUBLIC_URL=

# --- Routines (heure de Paris) ---
BRIEFING_TIME=07:00
EVENING_TIME=21:30
