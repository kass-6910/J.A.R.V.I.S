# --- Serveur ---
PORT=3000
HOST=0.0.0.0
TIMEZONE=Europe/Paris
# Jeton secret des Raccourcis et de la web app (générer avec : openssl rand -hex 32)
JARVIS_TOKEN=
DATABASE_URL=postgres://jarvis:jarvis@localhost:5432/jarvis

# --- IA (console Anthropic) ---
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-sonnet-5-5
# Petites tâches de fond : tri des mails, classement des tâches par espace.
JARVIS_BACKGROUND_MODEL=claude-haiku-5-5
JARVIS_EFFORT=medium

# --- Planning ---
PLANNING_DAY_START=08:00
PLANNING_DAY_END=22:00

# --- Google : Agenda (lecture) et Gmail (lecture, envoi des réponses validées). Laisser vide pour démarrer sans. ---
# Obtenir le refresh token : npm run google:auth -w server
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_IDS=primary
# Passer à true une fois le refresh token obtenu avec les droits Gmail (npm run google:auth).
GMAIL_ENABLED=false

# --- Outlook de l'école (Microsoft Graph). Laisser vide pour démarrer sans. ---
# Obtenir le refresh token : npm run outlook:auth -w server
MS_CLIENT_ID=
MS_TENANT=organizations
MS_REFRESH_TOKEN=

# --- Notifications (ntfy) ---
# Installer l'app ntfy sur l'iPhone et s'abonner au sujet ci-dessous.
# Choisir un sujet long et imprévisible (openssl rand -hex 16) : sur ntfy.sh, qui connaît le sujet peut lire les messages.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Jeton d'accès, si le serveur ntfy est protégé (serveur ntfy auto-hébergé ou compte ntfy.sh).
NTFY_TOKEN=
# Adresse de la web app, ouverte quand on touche une notification.
PUBLIC_URL=

# --- Routines (heure de Paris) ---
BRIEFING_TIME=07:00
EVENING_TIME=21:30

# --- Prière (horaires calculés par Aladhan ; Lyon par défaut) ---
PRAYER_ENABLED=true
PRAYER_LATITUDE=45.764
PRAYER_LONGITUDE=4.8357
# Méthode de calcul Aladhan : 12 = UOIF (France), 3 = Ligue islamique mondiale, 2 = ISNA...
PRAYER_METHOD=12
PRAYER_DURATION_MIN=15
PRAYER_NOTIFY_BEFORE_MIN=10
# Recueils du rappel du jour (éditions françaises de la collection hadith-api).
HADITH_EDITIONS=fra-bukhari,fra-muslim,fra-nawawi

# --- Repas : heures préférées (déplacées si la journée change), objectif de prise de poids ---
MEAL_TIMES=matin=08:00,midi=12:30,collation=16:30,soir=19:30
MEAL_KCAL_TARGET=3000
MEAL_PROTEIN_G=140
MEAL_PREFERENCES=halal (ni porc ni alcool), cuisine simple, moins de 30 minutes en semaine

# --- Sport ---
SPORT_SESSIONS_PER_WEEK=3
SPORT_DURATION_MIN=60
SPORT_PREFERRED_START=18:00

# --- Manageo (API dédiée à Jarvis, lecture seule ; voir docs/manageo-api.md). Laisser vide pour démarrer sans. ---
MANAGEO_URL=
MANAGEO_API_KEY=
# Facultatif si les slugs Manageo sont lmdd-confluence et lmdd-croix-rousse : « lmdd-confluence:12,lmdd-croix-rousse:14 »
MANAGEO_SHOPS=
# Une rupture est signalée quand le stock tombe à zéro dans ce nombre de jours au rythme des ventes.
STOCK_RUPTURE_HORIZON_DAYS=3

# --- Budget perso ---
# Plafond des dépenses perso du mois en euros (0 = pas d'alerte). Alerte à 80 % puis au dépassement.
BUDGET_MONTHLY_EUR=0
# Dossier des fichiers de Jarvis : photos de factures et de vêtements. À sauvegarder avec la base.
DATA_DIR=data

# --- Météo (tenue du jour), par Open-Meteo, sans clé ; Lyon par défaut ---
WEATHER_LATITUDE=45.764
WEATHER_LONGITUDE=4.8357

# --- Trajets (Google Maps, API Routes). Laisser vide pour démarrer sans. ---
GOOGLE_MAPS_API_KEY=
HOME_ADDRESS=
# TRANSIT (TCL) ou DRIVE (voiture), et la marge avant de partir.
TRAVEL_MODE=TRANSIT
TRAVEL_BUFFER_MIN=10
