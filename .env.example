# --- Serveur ---
PORT=3000
HOST=0.0.0.0
TIMEZONE=Europe/Paris
# Jeton secret des Raccourcis et de la web app (générer avec : openssl rand -hex 32)
JARVIS_TOKEN=
DATABASE_URL=postgres://jarvis:jarvis@localhost:5432/jarvis

# --- IA (console Anthropic) ---
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-sonnet-5-5
JARVIS_EFFORT=medium

# --- Planning ---
PLANNING_DAY_START=08:00
PLANNING_DAY_END=22:00

# --- Google Agenda (lecture seule). Laisser vide pour démarrer sans agenda. ---
# Obtenir le refresh token : npm run google:auth -w server
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_IDS=primary
